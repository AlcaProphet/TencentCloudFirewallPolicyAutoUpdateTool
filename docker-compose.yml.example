# FWAlizer Docker Compose 示例
# 复制此文件为 docker-compose.yml 并根据需要修改

version: "3.8"

services:
  fwalizer:
    # 使用预构建镜像（推荐）
    image: ghcr.io/alcaprophet/fwalizer:latest
    # 或本地构建：
    # build:
    #   context: .
    #   dockerfile: build/Dockerfile
    #   args:
    #     VERSION: local

    container_name: fwalizer

    # ---- 环境变量 ----
    environment:
      # 数据目录路径（可选，默认 ~/.config/fwalizer）
      # 在 Docker 中建议显式指定，避免依赖 HOME 目录
      - FWALIZER_DATA_DIR=/app/data

      # 同步间隔（可选，默认 30m）
      - INTERVAL=30m

      # 自定义 DNS 服务器（可选，默认系统 DNS）
      # - DNS=8.8.8.8:53

      # WebUI 端口（可选，默认 9090）
      - WEBUI_PORT=9090

      # 日志级别（可选，默认 info）
      - LOG_LEVEL=info

    # ---- 端口映射 ----
    # WebUI 模式：暴露 WebUI 端口
    ports:
      - "9090:9090"

    # ---- 卷挂载 ----
    volumes:
      # 数据持久化（SQLite 数据库存储于此）
      - fwalizer_data:/app/data

      # .env 模式：挂载配置文件（二选一）
      # - ./config/.env:/app/.env:ro

    # ---- 健康检查 ----
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -q -O /dev/null http://localhost:9090/api/health 2>/dev/null || pgrep fwalizer || exit 1",
        ]
      interval: 30s
      timeout: 3s
      start_period: 10s
      retries: 3

    # ---- 重启策略 ----
    restart: unless-stopped

    # ---- 运行模式 ----
    # 默认启动为 WebUI 模式
    # 若需 .env 模式，取消注释下面两行并注释 ports 和 healthcheck：
    # command: ["/fwalizer"]
    # 并确保已挂载 .env 文件

    # ---- WebUI 模式 ----
    command: ["/fwalizer", "webui"]

volumes:
  fwalizer_data:
    driver: local
